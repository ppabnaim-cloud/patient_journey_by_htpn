# ===========================================================================
# Patient Journey by HTPN — environment
# Copy to .env.local for local work, or set these in Vercel > Settings >
# Environment Variables for a deployment.
#
# BOTH flags default to OFF. The app collects nothing until both are on.
# ===========================================================================

# --- Flag 1 of 2: the CLIENT flag. Controls the UI only. -------------------
# false (or unset)  the consent question is never asked, the privacy screen
#                   says nothing leaves the device, and nothing is sent.
# true              the consent question is asked once, and usage counts are
#                   sent for patients who agree.
VITE_COLLECTION_ENABLED=false

# --- Flag 2 of 2: the SERVER flag. This one is authoritative. --------------
# The server returns 503 and writes nothing while this is false, even if a
# client build was shipped with its own flag on. This is what makes "ethics
# approval pending" enforceable rather than a promise.
COLLECTION_ENABLED=false

# --- Destination. The first one configured wins. ---------------------------

# (b) Apps Script Web App — the one that usually works.
#     Apps Script is a Workspace service, not Google Cloud Platform, so it
#     survives the GCP block that government Workspace tenants normally have.
#     See apps-script/Code.gs; run setup() there to generate the secret.
#     The secret is NOT optional: a Web App set to "Anyone" is reachable by
#     URL alone, and the server refuses to use this route without one.
# APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# APPS_SCRIPT_SECRET=

# (a) Sheets API via a service account — better, if GCP is available to you.
# SHEETS_SPREADSHEET_ID=
# SHEETS_TAB=usage
# GOOGLE_SA_EMAIL=
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (c) Neither configured: the row is written to the function log as a
#     tab-separated line that pastes into a sheet in one action. For email,
#     use the Apps Script route and run enableDailyDigest() there — Apps Script
#     can send mail from inside the Workspace; a serverless function cannot
#     without yet another third-party credential.

# --- feedback form (tab 9) -------------------------------------------------
# A SECOND Google Sheet and a SECOND Apps Script deployment, separate from the
# usage one above. See the header of apps-script/Feedback.gs.
# Both this and FEEDBACK_ENABLED inside Feedback.gs must be true before a
# single submission is written. Both default to false.
VITE_FEEDBACK_ENABLED=false
VITE_FEEDBACK_URL=
VITE_FEEDBACK_SECRET=
